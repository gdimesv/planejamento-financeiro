<!doctype html>
<html lang="pt-BR">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Relatório Financeiro - {{ cliente_nome }} - {{ mes }}</title>
  <link rel="stylesheet" href="https://cdn.datatables.net/1.13.7/css/jquery.dataTables.min.css">
  <style>{{ report_css|safe }}</style>
</head>
<body>
  {% macro stacked_cashflow_chart(rows, max_abs) -%}
  <div class="cashflow-chart">
    {% for linha in rows %}
    <div class="cashflow-row">
      <div class="cashflow-date">{{ linha.mes }}</div>
      <div class="cashflow-bars">
        <div class="cashflow-negative">
          {% for seg in linha.negative_segments %}
          <span class="bar-segment" style="width: {{ (seg.valor / max_abs * 100) }}%; background-color: {{ seg.color }};" title="{{ seg.key }}: {{ seg.valor|brl }}"></span>
          {% endfor %}
        </div>
        <div class="cashflow-positive">
          {% for seg in linha.positive_segments %}
          <span class="bar-segment" style="width: {{ (seg.valor / max_abs * 100) }}%; background-color: {{ seg.color }};" title="{{ seg.key }}: {{ seg.valor|brl }}"></span>
          {% endfor %}
        </div>
      </div>
      <div class="cashflow-net">{{ linha.variacao|default(linha.total_brl, true)|brl }}</div>
    </div>
    {% endfor %}
  </div>
  {%- endmacro %}
  {% macro chart_legend(items, label_field) -%}
  <div class="legend">
    {% for item in items %}
    <span class="legend-item"><span class="legend-swatch" style="background-color: {{ item.color }};"></span>{{ item[label_field] }}: {{ item.valor|brl }}</span>
    {% endfor %}
  </div>
  {%- endmacro %}
  {% macro metric_value(item) -%}
    {%- if item.kind == "currency" -%}
      {{ item.value|brl }}
    {%- elif item.kind == "percent" -%}
      {{ item.value|pct }}
    {%- else -%}
      {{ item.value }}
    {%- endif -%}
  {%- endmacro %}
  {% macro fii_action_label(action) -%}
    {%- if action == "Aumentar posicao" -%}
      Aumentar posição
    {%- elif action == "Encerrar posicao" -%}
      Encerrar posição
    {%- elif action == "Reduzir / nao aumentar" -%}
      Reduzir / não aumentar
    {%- else -%}
      {{ action }}
    {%- endif -%}
  {%- endmacro %}
  {% macro badge_class(action) -%}
    {%- if action in ["Comprar", "Aumentar posicao"] -%}badge-buy
    {%- elif action in ["Encerrar posicao"] -%}badge-sell
    {%- elif action in ["Aguardar", "Reduzir / nao aumentar"] -%}badge-wait
    {%- else -%}badge-neutral
    {%- endif -%}
  {%- endmacro %}
  {% macro recommendation_toggle_list(groups) -%}
  <div class="toggle-group-list">
    {% for group in groups %}
    <details class="toggle-group"{% if group.default_open %} open{% endif %}>
      <summary class="toggle-summary">
        <span class="badge {{ badge_class(group.acao) }}">{{ fii_action_label(group.acao) }}</span>
        <span class="toggle-count">{{ group.count }} ativo(s)</span>
        <span class="toggle-value">{{ group.valor_total|brl }}</span>
      </summary>
      {% if group.motivo_comum %}
      <p class="toggle-motivo">{{ group.motivo_comum }}</p>
      {% endif %}
      <div class="table-wrap">
        <table>
          <tr>
            <th class="num">Rank</th>
            <th>Ativo</th>
            <th>Viés</th>
            <th>Na carteira?</th>
            <th class="num">Valor atual</th>
            <th>Observação</th>
          </tr>
          {% for linha in group.rows %}
          <tr>
            <td class="num">{{ linha.rank }}</td>
            <td>{{ linha.ticker }}</td>
            <td>{{ linha.vies }}</td>
            <td>{% if linha.em_carteira %}Sim{% else %}Não{% endif %}</td>
            <td class="num">{{ linha.valor_atual|brl }}</td>
            <td>{{ linha.motivo_diferente }}</td>
          </tr>
          {% endfor %}
        </table>
      </div>
    </details>
    {% endfor %}
  </div>
  {%- endmacro %}

  <div class="layout">
    <a class="mobile-back-link" href="/setup/{{ cliente_id }}/{{ mes }}">← Voltar para o setup do mês</a>
    <button class="mobile-nav-toggle" type="button" aria-expanded="false" aria-controls="mobile-nav-list">☰ Navegar pelo relatório</button>
    <ul class="mobile-nav-list" id="mobile-nav-list">
      <li><a href="#resumo" data-section="resumo">📊 Resumo</a></li>
      <li><a href="#leitura" data-section="leitura">🧭 Leitura do mês</a></li>
      <li><a href="#evolucao-patrimonial" data-section="evolucao-patrimonial">📈 Evolução patrimonial</a></li>
      <li><a href="#objetivos" data-section="objetivos">🎯 Objetivos</a></li>
      <li><a href="#diagnostico" data-section="diagnostico">📈 Diagnóstico da carteira</a></li>
      <li><a href="#posicao" data-section="posicao">💼 Posição atual</a></li>
      <li><a href="#movimentos" data-section="movimentos">🔁 Compras e vendas</a></li>
      <li><a href="#fiis" data-section="fiis">🏢 Carteira de FIIs</a></li>
      <li><a href="#acoes" data-section="acoes">📈 Carteira de Ações</a></li>
      <li><a href="#novos" data-section="novos">🆕 Ativos novos</a></li>
      <li><a href="#dividendos" data-section="dividendos">💰 Dividendos</a></li>
      <li><a href="#externos" data-section="externos">🔀 Aportes externos</a></li>
      <li><a href="#mom" data-section="mom">📆 Variação MoM</a></li>
    </ul>

    <aside class="sidebar">
      <div class="sidebar-brand">
        <a class="back-link" href="/setup/{{ cliente_id }}/{{ mes }}">← Voltar para o setup do mês</a>
        <p class="eyebrow">Relatório financeiro mensal</p>
        <h1>{{ cliente_nome }}</h1>
        <div class="sidebar-meta">Mês de referência <strong>{{ mes }}</strong></div>
      </div>
      <nav class="sidebar-nav">
        <a href="#resumo" data-section="resumo">📊 Resumo</a>
        <a href="#leitura" data-section="leitura">🧭 Leitura do mês</a>
        <a href="#evolucao-patrimonial" data-section="evolucao-patrimonial">📈 Evolução patrimonial</a>
        <a href="#objetivos" data-section="objetivos">🎯 Objetivos</a>
        <a href="#diagnostico" data-section="diagnostico">📈 Diagnóstico da carteira</a>
        <a href="#posicao" data-section="posicao">💼 Posição atual</a>
        <a href="#movimentos" data-section="movimentos">🔁 Compras e vendas</a>
        <a href="#fiis" data-section="fiis">🏢 Carteira de FIIs</a>
        <a href="#acoes" data-section="acoes">📈 Carteira de Ações</a>
        <a href="#novos" data-section="novos">🆕 Ativos novos</a>
        <a href="#dividendos" data-section="dividendos">💰 Dividendos</a>
        <a href="#externos" data-section="externos">🔀 Aportes externos</a>
        <a href="#mom" data-section="mom">📆 Variação MoM</a>
      </nav>
      <div class="sidebar-footer">Gerado localmente</div>
    </aside>

    <main class="content">
      <section class="section" id="resumo" aria-label="Resumo executivo">
        <div class="kpi-grid">
          {% for item in view.kpis %}
          <article class="kpi">
            <div class="kpi-label">{{ item.label }}</div>
            <div class="kpi-value {{ item.tone }}">{{ metric_value(item) }}</div>
            <div class="kpi-context">
              {% if item.context_value is defined %}
                {{ item.context_value|pct }}
              {% else %}
                {{ item.context }}
              {% endif %}
            </div>
            {% if item.note %}
            <div class="kpi-note">{{ item.note }}</div>
            {% endif %}
          </article>
          {% endfor %}
        </div>
      </section>

      <section class="section" id="leitura" aria-label="Leitura do mês">
        <div class="section-header">
          <h2>Leitura do mês</h2>
          <div class="section-kicker">Como estou, o que mudou e qual é a próxima ação.</div>
        </div>
        <div class="insight-grid">
          {% for insight in view.insights %}
          <article class="callout {{ insight.tone }}">
            <div class="insight-label">{{ insight.label }}</div>
            <div class="insight-title">{{ insight.title }}</div>
            <div class="insight-detail">{{ insight.detail }}</div>
          </article>
          {% endfor %}
        </div>
      </section>

      <section class="section" id="evolucao-patrimonial" aria-label="Evolução patrimonial">
        <div class="section-header">
          <h2>Evolução patrimonial</h2>
          <div class="section-kicker">Variação do patrimônio total mês a mês, com o histórico disponível.</div>
        </div>
        <article class="card">
          <div class="summary-grid">
            <div class="summary-item">
              <div class="summary-label">Patrimônio inicial</div>
              <div class="summary-value neutral">{{ historico_patrimonio.patrimonio_inicial|brl }}</div>
            </div>
            <div class="summary-item">
              <div class="summary-label">Patrimônio final</div>
              <div class="summary-value neutral">{{ historico_patrimonio.patrimonio_final|brl }}</div>
            </div>
          </div>

          {% if historico_patrimonio.variacao_por_mes %}
          {{ stacked_cashflow_chart(historico_patrimonio.variacao_por_mes, historico_patrimonio.max_abs_mensal) }}
          {{ chart_legend(historico_patrimonio.legend, "key") }}
          <p class="dt-filter-note">Variação mensal do patrimônio total, quebrada por origem (Brasil ou Exterior).</p>
          {% else %}
          <p class="note">Ainda não há histórico de mais de um mês para montar a evolução.</p>
          {% endif %}
        </article>
      </section>

      <section class="section" id="objetivos" aria-label="Objetivos">
        <div class="section-header">
          <h2>Objetivos</h2>
          <div class="section-kicker">Acompanhamento por mapeamento de ativos.</div>
        </div>
        <article class="panel">
          {% if view.goal_cards %}
          <div class="goal-list">
            {% for g in view.goal_cards %}
            <div class="goal-card">
              <div>
                <div class="action-title">{{ g.descricao }}</div>
                <div class="action-meta">{{ g.status }} · prioridade {{ g.prioridade }}</div>
                <div class="progress-track" aria-label="Progresso de {{ g.descricao }}">
                  <div class="progress-fill" style="width: {{ g.progresso_visual }}%;"></div>
                </div>
              </div>
              <div class="goal-stats">
                <span>{{ g.valor_atual_estimado|brl }} de {{ g.valor_alvo|brl }}</span>
                <span>{{ g.progresso_pct|pct }} concluído</span>
                <span>Gap: {{ g.gap|brl }}</span>
              </div>
            </div>
            {% endfor %}
          </div>
          {% else %}
          <p class="note">Nenhum objetivo cadastrado.</p>
          {% endif %}
        </article>
      </section>

      <section class="section" id="diagnostico" aria-label="Alocação e variação">
        <div class="section-header">
          <h2>Diagnóstico da carteira</h2>
          <div class="section-kicker">Alocação atual e variação por classe.</div>
        </div>
        <div class="analytics-grid">
          <article class="panel">
            <h3>Alocação por classe</h3>
            <div class="bar-list">
              {% for row in view.allocation_chart %}
              <div class="bar-row">
                <div class="bar-label">{{ row.classe }}</div>
                <div class="bar-track">
                  <div class="bar-fill" style="width: {{ row.width }}%;"></div>
                </div>
                <div class="bar-value">{{ row.percentual|pct }}</div>
              </div>
              {% endfor %}
            </div>
          </article>

          <article class="panel">
            <h3>Variação mensal por classe</h3>
            <div class="bar-list">
              {% for row in view.variation_chart %}
              <div class="bar-row">
                <div class="bar-label">{{ row.classe }}</div>
                <div class="bar-track">
                  <div class="bar-fill {{ row.tone }}" style="width: {{ row.width }}%;"></div>
                </div>
                <div class="bar-value {{ row.tone }}">{{ row.valor|brl }} · {{ row.delta_label }}</div>
              </div>
              {% endfor %}
            </div>
          </article>
        </div>
      </section>

      <section class="section" id="posicao" aria-label="Posição atual">
        <article class="card">
          <h2>Posição atual</h2>
          <div class="summary-grid">
            <div class="summary-item">
              <div class="summary-label">Patrimônio investido</div>
              <div class="summary-value">{{ posicao.investido|brl }}</div>
            </div>
            <div class="summary-item">
              <div class="summary-label">Caixa disponível</div>
              <div class="summary-value">{{ posicao.caixa|brl }}</div>
            </div>
            <div class="summary-item">
              <div class="summary-label">Patrimônio total</div>
              <div class="summary-value">{{ posicao.total|brl }}</div>
            </div>
          </div>
          <div class="table-wrap">
            <table>
              <tr>
                <th>Classe</th>
                <th>Subclasse</th>
                <th class="num">M0</th>
                <th class="num">M1</th>
                <th class="num">Variação</th>
                <th class="num">Variação %</th>
                <th class="num">Representatividade</th>
              </tr>
              {% for linha in posicao.alocacao_tabela %}
              <tr>
                <td>{{ linha.classe }}</td>
                <td>{{ linha.subclasse }}</td>
                <td class="num">{{ linha.m0|brl }}</td>
                <td class="num">{{ linha.m1|brl }}</td>
                <td class="num {{ 'positive' if linha.variacao > 0 else 'negative' if linha.variacao < 0 else 'neutral' }}">{{ linha.variacao|brl }}</td>
                <td class="num {{ 'positive' if linha.variacao_pct > 0 else 'negative' if linha.variacao_pct < 0 else 'neutral' }}">{{ linha.variacao_pct|pct }}</td>
                <td class="num">{{ linha.representatividade_pct|pct }}</td>
              </tr>
              {% endfor %}
            </table>
          </div>
        </article>
      </section>

      <section class="section" id="movimentos" aria-label="Compras e vendas">
        <article class="card">
          <h2>Compras e vendas identificadas</h2>
          {% if compras_vendas.total_movimentos %}
          <p class="note">Resumo calculado pela variação entre M1 e M0. Ativos sem quantidade informada aparecem como aumento ou redução por valor.</p>
          <div class="movement-grid">
            <div class="movement-panel">
              <h3 class="positive">Compras / aumentos</h3>
              <p><strong>{{ compras_vendas.compras.quantidade }}</strong> movimento(s), total estimado de <strong>{{ compras_vendas.compras.valor_total|brl }}</strong>.</p>
              {% if compras_vendas.compras.principais %}
              <ul class="movement-list">
                {% for linha in compras_vendas.compras.principais %}
                <li>
                  <div>
                    <div class="movement-name">{{ linha.ativo }}</div>
                    <div class="movement-detail">{{ linha.tipo }}{% if linha.delta_quantidade %} · qtd {{ linha.delta_quantidade }}{% endif %}</div>
                  </div>
                  <div class="movement-value positive">{{ linha.delta_valor|brl }}</div>
                </li>
                {% endfor %}
              </ul>
              {% endif %}
            </div>
            <div class="movement-panel">
              <h3 class="negative">Vendas / reduções</h3>
              <p><strong>{{ compras_vendas.vendas.quantidade }}</strong> movimento(s), total estimado de <strong>{{ compras_vendas.vendas.valor_total|brl }}</strong>.</p>
              {% if compras_vendas.vendas.principais %}
              <ul class="movement-list">
                {% for linha in compras_vendas.vendas.principais %}
                <li>
                  <div>
                    <div class="movement-name">{{ linha.ativo }}</div>
                    <div class="movement-detail">{{ linha.tipo }}{% if linha.delta_quantidade %} · qtd {{ linha.delta_quantidade|abs }}{% endif %}</div>
                  </div>
                  <div class="movement-value negative">{{ linha.delta_valor|brl }}</div>
                </li>
                {% endfor %}
              </ul>
              {% endif %}
            </div>
          </div>
          {% else %}
          <p class="note">Nenhuma compra ou venda identificada pela comparação de posições.</p>
          {% endif %}
        </article>
      </section>

      <section class="section" id="fiis" aria-label="Carteira recomendada de FIIs">
        <article class="card">
          <h2>Carteira recomendada de FIIs</h2>
          {% if recomendacoes_fii.disponivel %}
          <div class="summary-grid">
            <div class="summary-item">
              <div class="summary-label">Comprar</div>
              <div class="summary-value positive">{{ recomendacoes_fii.resumo.comprar }}</div>
            </div>
            <div class="summary-item">
              <div class="summary-label">Aumentar</div>
              <div class="summary-value positive">{{ recomendacoes_fii.resumo.aumentar }}</div>
            </div>
            <div class="summary-item">
              <div class="summary-label">Reduzir / aguardar</div>
              <div class="summary-value">{{ recomendacoes_fii.resumo.reduzir }}</div>
            </div>
            <div class="summary-item">
              <div class="summary-label">Encerrar</div>
              <div class="summary-value negative">{{ recomendacoes_fii.resumo.encerrar }}</div>
            </div>
          </div>
          {{ recommendation_toggle_list(view.recomendacoes_fii_groups) }}
          {% elif recomendacoes_fii.arquivo_encontrado %}
          <p class="note">Encontramos um arquivo de carteira recomendada de FIIs para este mês, mas ele não tinha nenhuma linha de recomendação válida (provavelmente a coleta da Suno falhou ou salvou o CSV vazio). Rode novamente <code>./scripts/suno-fiis/run-suno-fiis.sh --cliente {{ cliente_id }} --mes {{ mes }}</code> e gere o relatório de novo.</p>
          {% else %}
          <p class="note">Nenhum arquivo de carteira recomendada de FIIs encontrado para este mês.</p>
          {% endif %}
        </article>
      </section>

      <section class="section" id="acoes" aria-label="Carteira recomendada de Ações (Dividendos)">
        <article class="card">
          <h2>Carteira recomendada de Ações (Dividendos)</h2>
          {% if recomendacoes_acoes.disponivel %}
          <div class="summary-grid">
            <div class="summary-item">
              <div class="summary-label">Comprar</div>
              <div class="summary-value positive">{{ recomendacoes_acoes.resumo.comprar }}</div>
            </div>
            <div class="summary-item">
              <div class="summary-label">Aumentar</div>
              <div class="summary-value positive">{{ recomendacoes_acoes.resumo.aumentar }}</div>
            </div>
            <div class="summary-item">
              <div class="summary-label">Reduzir / aguardar</div>
              <div class="summary-value">{{ recomendacoes_acoes.resumo.reduzir }}</div>
            </div>
            <div class="summary-item">
              <div class="summary-label">Encerrar</div>
              <div class="summary-value negative">{{ recomendacoes_acoes.resumo.encerrar }}</div>
            </div>
          </div>
          {{ recommendation_toggle_list(view.recomendacoes_acoes_groups) }}
          {% elif recomendacoes_acoes.arquivo_encontrado %}
          <p class="note">Encontramos um arquivo de carteira recomendada de Ações para este mês, mas ele não tinha nenhuma linha de recomendação válida (provavelmente a coleta da Suno falhou ou salvou o CSV vazio). Rode novamente <code>./scripts/suno-acoes/run-suno-acoes.sh --cliente {{ cliente_id }} --mes {{ mes }}</code> e gere o relatório de novo.</p>
          {% else %}
          <p class="note">Nenhum arquivo de carteira recomendada de ações encontrado para este mês.</p>
          {% endif %}
        </article>
      </section>

      <section class="section" id="novos" aria-label="Ativos novos sem classificação">
        <article class="card">
          <h2>Ativos novos sem classificação</h2>
          {% if ativos_nao_mapeados %}
          <p class="note">Classifique estes ativos na interface para atualizar os objetivos no próximo relatório.</p>
          <div class="table-wrap">
            <table>
              <tr>
                <th>Ativo</th>
                <th>Classe</th>
                <th class="num">Valor M0</th>
              </tr>
              {% for a in ativos_nao_mapeados %}
              <tr>
                <td>{{ a.ativo }}</td>
                <td>{{ a.classe_macro }}</td>
                <td class="num">{{ a.valor_ativo|brl }}</td>
              </tr>
              {% endfor %}
            </table>
          </div>
          {% else %}
          <p class="note">Nenhum ativo novo sem classificação neste mês.</p>
          {% endif %}
        </article>
      </section>

      <section class="section" id="dividendos" aria-label="Dividendos e proventos">
        <article class="card">
          <h2>Dividendos e proventos (Brasil + Exterior)</h2>
          <p class="note">
            Junta os proventos identificados no extrato da XP Brasil (dividendos, JCP, juros e rendimentos) com os
            dividendos da XP International, convertidos para BRL pela cotação que você informou em cada mês.
          </p>
          <div class="summary-grid">
            <div class="summary-item">
              <div class="summary-label">Recebido no mês</div>
              <div class="summary-value positive">{{ dividendos.mes_total_brl|brl }}</div>
            </div>
            <div class="summary-item">
              <div class="summary-label">Acumulado no histórico</div>
              <div class="summary-value positive">{{ dividendos.acumulado_brl|brl }}</div>
            </div>
          </div>

          {% if dividendos.historico_mensal %}
          <div class="toggle-tabs" role="tablist" aria-label="Tipo de agrupamento do gráfico de dividendos">
            <button type="button" class="toggle-tab is-active" data-dividendos-view="mensal">Sem agrupamento</button>
            <button type="button" class="toggle-tab" data-dividendos-view="origem">Por origem</button>
            <button type="button" class="toggle-tab" data-dividendos-view="ativo">Por ativo</button>
          </div>

          <div data-dividendos-panel="mensal">
            <div class="cashflow-chart">
              {% for linha in dividendos.historico_mensal %}
              <div class="cashflow-row">
                <div class="cashflow-date">{{ linha.mes }}</div>
                <div class="cashflow-bars">
                  <div class="cashflow-negative"></div>
                  <div class="cashflow-positive">
                    {% set gain_width = (linha.total_brl / dividendos.max_abs_mensal * 100) %}
                    {% if linha.total_brl > 0 %}
                    <span class="bar-gain" style="width: {{ gain_width }}%;"></span>
                    {% endif %}
                  </div>
                </div>
                <div class="cashflow-net">{{ linha.total_brl|brl }}</div>
              </div>
              {% endfor %}
              <div class="legend">
                <span class="legend-gain">Dividendos e proventos recebidos por mês</span>
              </div>
            </div>
            <p class="dt-filter-note">Histórico mensal a partir de todos os meses disponíveis (Brasil + Exterior combinados).</p>
          </div>

          <div data-dividendos-panel="origem" hidden>
            {{ stacked_cashflow_chart(dividendos.historico_mensal_origem, dividendos.max_abs_mensal) }}
            {{ chart_legend(dividendos.por_carteira, "carteira") }}
            <p class="dt-filter-note">Histórico mensal quebrado por origem (Brasil ou Exterior); legenda com o total acumulado de cada uma.</p>
          </div>

          <div data-dividendos-panel="ativo" hidden>
            {{ stacked_cashflow_chart(dividendos.historico_mensal_ativo, dividendos.max_abs_mensal) }}
            {{ chart_legend(dividendos.por_ativo, "ativo") }}
            <p class="dt-filter-note">
              Histórico mensal quebrado pelos 8 ativos que mais pagaram (acumulado); "Outros ativos" junta o restante,
              incluindo proventos do extrato BR cujo ativo não foi possível identificar automaticamente na descrição.
            </p>
          </div>

          <p class="dt-filter-note">A tabela abaixo detalha apenas os eventos do mês do relatório.</p>
          <div class="table-wrap">
            <table id="tabela-dividendos" class="display compact stripe" style="width:100%">
              <thead>
                <tr>
                  <th>Data</th>
                  <th>Origem</th>
                  <th>Ativo</th>
                  <th>Descrição</th>
                  <th class="num">Valor (BRL)</th>
                </tr>
              </thead>
              <tbody>
              {% for evento in dividendos.eventos_mes %}
                <tr>
                  <td>{{ evento.data }}</td>
                  <td>{{ evento.origem }}</td>
                  <td>{{ evento.ativo }}</td>
                  <td>{{ evento.descricao }}</td>
                  <td class="num" data-order="{{ evento.valor_brl }}">{{ evento.valor_brl|brl }}</td>
                </tr>
              {% endfor %}
              </tbody>
            </table>
          </div>
          {% else %}
          <p class="note">Nenhum dividendo ou provento identificado ainda.</p>
          {% endif %}
        </article>
      </section>

      <section class="section" id="externos" aria-label="Aportes e movimentações externas">
        <article class="card">
          <h2>Aportes e movimentações externas identificadas</h2>
          <p class="note">Transferências, TEDs, aplicações/resgates de fundos e operações em bolsa encontrados no extrato do mês. Isso explica parte da variação de patrimônio que não é rentabilidade.</p>
          {% if fluxos_externos.eventos %}
          <div class="summary-grid">
            <div class="summary-item">
              <div class="summary-label">Aporte externo</div>
              <div class="summary-value positive">{{ fluxos_externos.total_aporte_externo|brl }}</div>
            </div>
            <div class="summary-item">
              <div class="summary-label">Retirada externa</div>
              <div class="summary-value negative">{{ fluxos_externos.total_retirada_externa|brl }}</div>
            </div>
            <div class="summary-item">
              <div class="summary-label">Aporte líquido externo</div>
              <div class="summary-value {{ 'positive' if fluxos_externos.aporte_liquido_externo > 0 else 'negative' if fluxos_externos.aporte_liquido_externo < 0 else 'neutral' }}">{{ fluxos_externos.aporte_liquido_externo|brl }}</div>
            </div>
            <div class="summary-item">
              <div class="summary-label">Movimentação interna (fundos/bolsa)</div>
              <div class="summary-value neutral">{{ fluxos_externos.total_movimentacao_interna|brl }}</div>
            </div>
          </div>
          <div class="table-wrap">
            <table id="tabela-fluxos-externos" class="display compact stripe" style="width:100%">
              <thead>
                <tr>
                  <th>Data</th>
                  <th>Tipo</th>
                  <th>Descrição</th>
                  <th class="num">Valor</th>
                </tr>
              </thead>
              <tbody>
              {% for evento in fluxos_externos.eventos %}
                <tr>
                  <td>{{ evento.data }}</td>
                  <td>{{ evento.tipo }}</td>
                  <td>{{ evento.descricao }}</td>
                  <td class="num {{ 'positive' if evento.valor > 0 else 'negative' if evento.valor < 0 else 'neutral' }}" data-order="{{ evento.valor }}">{{ evento.valor|brl }}</td>
                </tr>
              {% endfor %}
              </tbody>
            </table>
          </div>
          {% else %}
          <p class="note">Nenhuma transferência, aplicação/resgate de fundo ou operação em bolsa identificada no extrato deste mês.</p>
          {% endif %}
        </article>
      </section>

      <section class="section" id="mom" aria-label="Variação dos ativos">
        <article class="card">
          <h2>Variação dos ativos MoM</h2>
          <p class="note">Variação total: <strong class="{{ 'positive' if mom.variacao_total > 0 else 'negative' if mom.variacao_total < 0 else 'neutral' }}">{{ mom.variacao_total|brl }} ({{ mom.variacao_percentual|pct }})</strong>.</p>
          <div class="table-wrap">
            <table id="tabela-mom" class="display compact stripe" style="width:100%">
              <thead>
                <tr>
                  <th>Ativo</th>
                  <th>Classe</th>
                  <th>Objetivo</th>
                  <th class="num">M0</th>
                  <th class="num">M1</th>
                  <th class="num">Variação</th>
                  <th class="num">Variação %</th>
                  <th class="num">Efeito compra/venda</th>
                  <th class="num">Efeito preço</th>
                </tr>
                <tr class="filters">
                  <th>Ativo</th>
                  <th>Classe</th>
                  <th>Objetivo</th>
                  <th class="num">M0</th>
                  <th class="num">M1</th>
                  <th class="num">Variação</th>
                  <th class="num">Variação %</th>
                  <th class="num">Efeito compra/venda</th>
                  <th class="num">Efeito preço</th>
                </tr>
              </thead>
              <tbody>
              {% for linha in mom_linhas %}
                <tr>
                  <td>{{ linha.ativo }}</td>
                  <td>{{ linha.classe }}</td>
                  <td>{{ linha.objetivo }}</td>
                  <td class="num" data-order="{{ linha.m0 }}">{{ linha.m0|brl }}</td>
                  <td class="num" data-order="{{ linha.m1 }}">{{ linha.m1|brl }}</td>
                  <td class="num {{ 'positive' if linha.variacao > 0 else 'negative' if linha.variacao < 0 else 'neutral' }}" data-order="{{ linha.variacao }}">{{ linha.variacao|brl }}</td>
                  <td class="num {{ 'positive' if linha.variacao_pct > 0 else 'negative' if linha.variacao_pct < 0 else 'neutral' }}" data-order="{{ linha.variacao_pct }}">{{ linha.variacao_pct|pct }}</td>
                  {% if linha.decomponivel %}
                  <td class="num {{ 'positive' if linha.efeito_quantidade > 0 else 'negative' if linha.efeito_quantidade < 0 else 'neutral' }}" data-order="{{ linha.efeito_quantidade }}">{{ linha.efeito_quantidade|brl }}</td>
                  <td class="num {{ 'positive' if linha.efeito_preco > 0 else 'negative' if linha.efeito_preco < 0 else 'neutral' }}" data-order="{{ linha.efeito_preco }}">{{ linha.efeito_preco|brl }}</td>
                  {% else %}
                  <td class="num neutral" data-order="0" title="Sem quantidade/preço confiáveis para esta classe (Fundos, COE, Renda Fixa, Tesouro Direto ou ativos internacionais)">-</td>
                  <td class="num neutral" data-order="0" title="Sem quantidade/preço confiáveis para esta classe (Fundos, COE, Renda Fixa, Tesouro Direto ou ativos internacionais)">-</td>
                  {% endif %}
                </tr>
              {% endfor %}
              </tbody>
            </table>
          </div>
        </article>
      </section>

    </main>
  </div>

  <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
  <script src="https://cdn.datatables.net/1.13.7/js/jquery.dataTables.min.js"></script>
  <script>
    (function () {
      if (typeof jQuery === 'undefined' || !jQuery.fn.dataTable) return;
      var $ = jQuery;
      $.fn.dataTable.ext.order['dom-data-order-num'] = function (settings, col) {
        return this.api()
          .column(col, { order: 'index' })
          .nodes()
          .map(function (td) {
            var raw = $(td).attr('data-order');
            var n = parseFloat(raw, 10);
            return isNaN(n) ? 0 : n;
          });
      };
      var momSelectColumns = [1, 2];
      $('#tabela-mom').DataTable({
        order: [[5, 'desc']],
        orderCellsTop: true,
        pageLength: 25,
        lengthMenu: [[10, 25, 50, 100, -1], [10, 25, 50, 100, 'Todos']],
        columnDefs: [{ targets: [3, 4, 5, 6, 7, 8], orderDataType: 'dom-data-order-num' }],
        language: {
          url: 'https://cdn.datatables.net/plug-ins/1.13.7/i18n/pt-BR.json'
        },
        initComplete: function () {
          var api = this.api();
          $('#tabela-mom thead tr.filters th').each(function (colIndex) {
            var column = api.column(colIndex);
            var cell = $(this);
            var title = cell.text();

            if (momSelectColumns.indexOf(colIndex) !== -1) {
              var select = $('<select><option value="">Todos</option></select>')
                .appendTo(cell.empty())
                .on('change', function () {
                  var val = $.fn.dataTable.util.escapeRegex($(this).val());
                  column.search(val ? '^' + val + '$' : '', true, false).draw();
                });
              column
                .data()
                .unique()
                .sort()
                .each(function (d) {
                  var text = $('<div>').html(d).text();
                  select.append('<option value="' + text + '">' + text + '</option>');
                });
            } else {
              $('<input type="text" placeholder="Filtrar ' + title + '" />')
                .appendTo(cell.empty())
                .on('click', function (e) {
                  e.stopPropagation();
                })
                .on('keyup change clear', function () {
                  if (column.search() !== this.value) {
                    column.search(this.value).draw();
                  }
                });
            }
          });
        }
      });
      $('#tabela-dividendos').DataTable({
        order: [[0, 'desc']],
        pageLength: 25,
        lengthMenu: [[10, 25, 50, 100, -1], [10, 25, 50, 100, 'Todos']],
        columnDefs: [{ targets: [4], orderDataType: 'dom-data-order-num' }],
        language: {
          url: 'https://cdn.datatables.net/plug-ins/1.13.7/i18n/pt-BR.json'
        }
      });
      $('#tabela-fluxos-externos').DataTable({
        order: [[0, 'desc']],
        pageLength: 25,
        lengthMenu: [[10, 25, 50, 100, -1], [10, 25, 50, 100, 'Todos']],
        columnDefs: [{ targets: [3], orderDataType: 'dom-data-order-num' }],
        language: {
          url: 'https://cdn.datatables.net/plug-ins/1.13.7/i18n/pt-BR.json'
        }
      });
    })();
  </script>
  <script>
    (function () {
      var toggle = document.querySelector('.mobile-nav-toggle');
      var mobileList = document.getElementById('mobile-nav-list');
      if (toggle && mobileList) {
        toggle.addEventListener('click', function () {
          var isOpen = mobileList.classList.toggle('open');
          toggle.setAttribute('aria-expanded', isOpen ? 'true' : 'false');
        });
        mobileList.querySelectorAll('a').forEach(function (link) {
          link.addEventListener('click', function () {
            mobileList.classList.remove('open');
            toggle.setAttribute('aria-expanded', 'false');
          });
        });
      }

      var navLinks = document.querySelectorAll('.sidebar-nav a, .mobile-nav-list a');
      var sections = Array.prototype.map.call(navLinks, function (link) {
        var id = link.getAttribute('data-section');
        return document.getElementById(id);
      }).filter(Boolean);

      if (!sections.length || typeof IntersectionObserver === 'undefined') return;

      function setActive(id) {
        navLinks.forEach(function (link) {
          link.classList.toggle('active', link.getAttribute('data-section') === id);
        });
      }

      var observer = new IntersectionObserver(function (entries) {
        entries.forEach(function (entry) {
          if (entry.isIntersecting) {
            setActive(entry.target.id);
          }
        });
      }, { rootMargin: '-15% 0px -70% 0px', threshold: 0 });

      sections.forEach(function (section) {
        observer.observe(section);
      });
    })();
  </script>

  <script>
    (function () {
      var tabs = document.querySelectorAll('[data-dividendos-view]');
      var panels = document.querySelectorAll('[data-dividendos-panel]');
      if (!tabs.length || !panels.length) return;

      tabs.forEach(function (tab) {
        tab.addEventListener('click', function () {
          var view = tab.getAttribute('data-dividendos-view');
          tabs.forEach(function (t) {
            t.classList.toggle('is-active', t === tab);
          });
          panels.forEach(function (panel) {
            panel.hidden = panel.getAttribute('data-dividendos-panel') !== view;
          });
        });
      });
    })();
  </script>
</body>
</html>
